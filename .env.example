# ScholarClaw 环境变量配置示例
# 复制此文件为 .env 并填入实际值

# ===========================================
# AI 模型配置
# ===========================================

# API 接口地址（兼容 OpenAI 格式的接口）
API_URL=https://modelgate.cn/v1

# API 密钥
API_KEY=your_api_key_here

# 主模型（用于对话）
PRIMARY_MODEL=qwen3.5-plus

# 写作助手模型（可选，不填则使用主模型）
WRITING_MODEL=

# Embedding API 配置（用于文献语义检索）
# 注意：Embedding 配置推荐在 Web UI 的"设置"页面中配置，配置会自动保存
# 以下环境变量仅作为后备选项，Web UI 配置优先级更高

# Embedding 模型名称（默认：text-embedding-3-small）
EMBEDDING_MODEL=text-embedding-3-small

# ===========================================
# 飞书机器人配置（可选）
# ===========================================

# 飞书应用 App ID（企业自建应用的凭证与基础信息中获取）
FEISHU_APP_ID=cli_xxxxxxxxxxxxx

# 飞书应用 App Secret（企业自建应用的凭证与基础信息中获取）
FEISHU_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 飞书验证 Token（可选，事件订阅页配置）
FEISHU_VERIFICATION_TOKEN=

# 飞书加密 Key（可选，事件订阅页配置）
FEISHU_ENCRYPT_KEY=

# ===========================================
# 网络搜索配置（可选）
# ===========================================

# Tavily API Key（用于联网搜索功能）
EXA_API_KEY=

# ===========================================
# 服务器配置
# ===========================================

# 服务端口（默认：18789）
PORT=18789

# 调试模式（1=开启详细日志）
DEBUG=
