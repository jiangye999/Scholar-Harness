{
  "name": "scholar-harness",
  "version": "1.0.7",
  "description": "Scholar Harness - 对话式学术论文写作助手",
  "author": "sjs@cau.edu.cn",
  "main": "dist/electron/main.js",
  "scripts": {
    "dev": "ts-node-dev --respawn src/server/local-server.ts",
    "build": "node scripts/check-public-js.js && tsc && node scripts/build-copy.js",
    "build:bytecode": "node scripts/run-bytecode-with-electron.js",
    "start": "node dist/src/server/local-server.js",
    "test": "vitest",
    "electron:dev": "npm run build && tsc -p electron/tsconfig.json && electron .",
    "electron:dev:no-window": "npm run build && tsc -p electron/tsconfig.json && set ELECTRON_NO_WINDOW=1 && electron .",
    "electron:dev:window": "npm run build && tsc -p electron/tsconfig.json && electron .",
    "electron:prepare": "node scripts/prepare-playwright.js",
    "electron:build": "npm run electron:prepare && npm run build && tsc -p electron/tsconfig.json && node scripts/build-copy.js && npm run build:bytecode && electron-builder --win",
    "electron:build:mac": "npm run electron:prepare && npm run build && tsc -p electron/tsconfig.json && node scripts/build-copy.js && npm run build:bytecode && node scripts/prepare-mac-icon.js && node scripts/write-mac-electron-builder-config.js && electron-builder --config dist/electron-builder-mac.json --mac --x64 --arm64 --publish never",
    "electron:build:signed": "node scripts/check-code-signing.js --required && npm run electron:build",
    "electron:build:debug": "npm run electron:prepare && npm run build && tsc -p electron/tsconfig.json && node scripts/build-copy.js && electron-builder --win",
    "electron:preview": "npm run build && tsc -p electron/tsconfig.json && electron .",
    "cloud:import-core-prompts": "ts-node cloud/scripts/import-core-prompts.ts"
  },
  "build": {
    "appId": "com.scholar-harness.app",
    "productName": "Scholar Harness",
    "toolsets": {
      "winCodeSign": "1.1.0"
    },
    "afterPack": "scripts/windows-after-pack.js",
    "asar": true,
    "asarUnpack": [
      "dist/**/*.js",
      "dist/**/*.jsc",
      "dist/src/public/**/*",
      "dist/electron/views/**/*",
      "dist/electron/icon.ico",
      "node_modules/**/*",
      "configs/**/*"
    ],
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "dist/**/*",
      "!dist/cloud/**/*",
      "configs/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "openclaw/index.js",
        "to": "openclaw/index.js"
      },
      {
        "from": "openclaw/package.json",
        "to": "openclaw/package.json"
      },
      {
        "from": "openclaw/browser-info.json",
        "to": "openclaw/browser-info.json"
      },
      {
        "from": "openclaw/node_modules",
        "to": "openclaw/node_modules"
      },
      {
        "from": "openclaw/browsers",
        "to": "openclaw/browsers"
      },
      {
        "from": "configs",
        "to": "configs"
      },
      {
        "from": "sci_writing_skills",
        "to": "sci_writing_skills"
      },
      {
        "from": "skill-packs",
        "to": "skill-packs"
      },
      {
        "from": "plugins",
        "to": "plugins"
      },
      {
        "from": "tools/ppt-master",
        "to": "tools/ppt-master"
      },
      {
        "from": "tools/getdata",
        "to": "tools/getdata",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "scripts/extract-pdf-visuals.py",
        "to": "scripts/extract-pdf-visuals.py"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "electron/icon.ico",
      "signAndEditExecutable": false,
      "verifyUpdateCodeSignature": true
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.education",
      "icon": "build/icon.icns",
      "artifactName": "${productName} Setup ${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "electron/icon.ico",
      "uninstallerIcon": "electron/icon.ico",
      "installerHeaderIcon": "electron/icon.ico",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Scholar Harness",
      "include": "electron/uninstaller.nsh",
      "deleteAppDataOnUninstall": false
    }
  },
  "dependencies": {
    "@llamaindex/liteparse": "^2.0.4",
    "@tesseract.js-data/chi_sim": "^1.0.0",
    "@tesseract.js-data/eng": "^1.0.0",
    "archiver": "^7.0.1",
    "axios": "^1.6.0",
    "bytenode": "^1.5.7",
    "dotenv": "^16.3.0",
    "express": "^4.18.2",
    "jszip": "^3.10.1",
    "mammoth": "^1.11.0",
    "multer": "^1.4.5-lts.1",
    "pdf-parse": "^2.4.5",
    "pdfjs-dist": "^5.5.207",
    "tesseract.js": "^7.0.0",
    "xlsx": "^0.18.5",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@types/archiver": "^6.0.4",
    "@types/body-parser": "^1.19.6",
    "@types/express": "^4.17.21",
    "@types/http-errors": "^2.0.5",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.0.0",
    "@types/qs": "^6.15.0",
    "@types/range-parser": "^1.2.7",
    "@types/send": "^1.2.1",
    "@types/supertest": "^7.2.0",
    "electron": "^33.4.11",
    "electron-builder": "^26.8.1",
    "fs-extra": "^11.3.4",
    "pkg": "^5.8.1",
    "supertest": "^7.2.2",
    "ts-node-dev": "^2.0.0",
    "tsx": "^4.21.0",
    "typescript": "^5.3.0",
    "vitest": "^1.0.0"
  },
  "packageManager": "npm@10.0.0"
}
