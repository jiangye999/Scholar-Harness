{
  "name": "scholar-harness-exe",
  "version": "1.0.0",
  "description": "Scholar Harness - 对话式学术论文写作助手 (exe版本)",
  "main": "dist/src/server/local-server.js",
  "pkg": {
    "targets": [
      "node22-win-x64"
    ],
    "outputPath": "dist/exe",
    "assets": [
      "src/public/**/*",
      "sci_writing_skills/**/*",
      "configs/**/*",
      "openclaw/**/*",
      "node_modules/**/*"
    ],
    "scripts": [
      "dist/src/**/*.js",
      "dist/agents/**/*.js",
      "dist/workflows/**/*.js"
    ]
  },
  "scripts": {
    "build": "tsc && xcopy /E /I /Y src\\public dist\\src\\public 2>nul",
    "build:exe": "npm run build && pkg . --targets node22-win-x64 --output dist/exe/scholar-harness.exe",
    "start": "node dist/src/server/local-server.js",
    "start:exe": "dist/exe/scholar-harness.exe"
  },
  "dependencies": {
    "axios": "^1.6.0",
    "dotenv": "^16.3.0",
    "express": "^4.18.2",
    "mammoth": "^1.11.0",
    "multer": "^1.4.5-lts.1",
    "pdf-parse": "^2.4.5",
    "pdfjs-dist": "^5.5.207",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.0.0",
    "pkg": "^5.8.1",
    "ts-node-dev": "^2.0.0",
    "tsx": "^4.21.0",
    "typescript": "^5.3.0",
    "vitest": "^1.0.0"
  }
}