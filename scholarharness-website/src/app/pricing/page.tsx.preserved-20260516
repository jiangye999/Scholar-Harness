'use client';

import { useState, useEffect } from 'react';
import { useRouter } from 'next/navigation';
import { isAuthenticated, purchasePlan, getStoredUser } from '@/lib/auth';
import Link from 'next/link';

interface Plan {
  type: string;
  name: string;
  price: number;
  validity: string;
  quota: string;
  fileUpload: string;
  recommended?: boolean;
  features: string[];
}

const plans: Plan[] = [
  {
    type: 'monthly',
    name: '月度套餐',
    price: 49,
    validity: '30天',
    quota: '500万字',
    fileUpload: '10个',
    features: [
      '访问所有AI模型',
      '每日额度追踪',
      '文件上传管理',
      '优先技术支持'
    ]
  },
  {
    type: 'quarterly',
    name: '季度套餐',
    price: 129,
    validity: '90天',
    quota: '2000万字',
    fileUpload: '30个',
    recommended: true,
    features: [
      '访问所有AI模型',
      '每日额度追踪',
      '文件上传管理',
      '优先技术支持',
      '推荐优惠'
    ]
  },
  {
    type: 'yearly',
    name: '年度套餐',
    price: 299,
    validity: '365天',
    quota: '1亿字',
    fileUpload: '100个',
    features: [
      '访问所有AI模型',
      '每日额度追踪',
      '文件上传管理',
      '优先技术支持',
      '年度折扣'
    ]
  },
  {
    type: 'lifetime',
    name: '永久套餐',
    price: 999,
    validity: '永久',
    quota: '无限',
    fileUpload: '无限',
    features: [
      '访问所有AI模型',
      '每日额度追踪',
      '文件上传管理',
      '优先技术支持',
      '永久使用权',
      '终身更新'
    ]
  }
];

export default function PricingPage() {
  const [isLoggedIn, setIsLoggedIn] = useState(false);
  const [loadingPlan, setLoadingPlan] = useState<string | null>(null);
  const [error, setError] = useState('');
  const router = useRouter();

  useEffect(() => {
    setIsLoggedIn(isAuthenticated());
  }, []);

  const handlePurchase = async (planType: string) => {
    setError('');
    
    if (!isLoggedIn) {
      router.push('/login?redirect=/pricing');
      return;
    }

    setLoadingPlan(planType);
    try {
      const result = await purchasePlan(planType, 'wechat');
      
      // Redirect to payment page with orderId
      if (result.pay_url) {
        // Extract orderId from pay_url or use result directly
        router.push(`/payment?orderId=${result.payment?.id || planType}`);
      } else {
        router.push('/dashboard');
      }
    } catch (err: any) {
      setError(err.message || '购买失败，请重试');
    } finally {
      setLoadingPlan(null);
    }
  };

  return (
    <div className="min-h-screen bg-gray-50 py-12 px-4 sm:px-6 lg:px-8">
      <div className="max-w-7xl mx-auto">
        {/* Header */}
        <div className="text-center mb-12">
          <h1 className="text-4xl font-bold text-gray-900 mb-4">选择套餐</h1>
          <p className="text-lg text-gray-600 max-w-2xl mx-auto">
            根据您的需求选择合适的套餐，享受AI论文写作助手带来的便利
          </p>
        </div>

        {/* Error Message */}
        {error && (
          <div className="max-w-md mx-auto mb-8 bg-red-50 border border-red-200 rounded-lg p-4 text-red-700">
            {error}
          </div>
        )}

        {/* Login Prompt */}
        {!isLoggedIn && (
          <div className="max-w-md mx-auto mb-8 bg-blue-50 border border-blue-200 rounded-lg p-4 text-blue-700 text-center">
            <p className="mb-2">购买套餐需要先登录账号</p>
            <Link href="/login?redirect=/pricing" className="inline-block px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white rounded-lg text-sm font-medium">
              立即登录
            </Link>
          </div>
        )}

        {/* Plans Grid */}
        <div className="grid md:grid-cols-2 lg:grid-cols-4 gap-6">
          {plans.map((plan) => (
            <div
              key={plan.type}
              className={`bg-white rounded-xl border-2 shadow-lg overflow-hidden transition hover:shadow-xl ${
                plan.recommended
                  ? 'border-blue-600 ring-2 ring-blue-600 ring-offset-2'
                  : 'border-gray-200'
              }`}
            >
              {/* Recommended Badge */}
              {plan.recommended && (
                <div className="bg-blue-600 text-white text-center py-2 text-sm font-medium">
                  推荐套餐
                </div>
              )}

              {/* Plan Header */}
              <div className="p-6">
                <h3 className="text-xl font-bold text-gray-900 mb-2">{plan.name}</h3>
                
                {/* Price */}
                <div className="mb-4">
                  <span className="text-4xl font-bold text-blue-600">¥{plan.price}</span>
                  <span className="text-gray-500 text-sm ml-2">/ {plan.validity}</span>
                </div>

                {/* Quota Info */}
                <div className="space-y-2 mb-6 text-sm text-gray-600">
                  <div className="flex items-center gap-2">
                    <svg className="w-4 h-4 text-blue-600" fill="currentColor" viewBox="0 0 20 20">
                      <path fillRule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clipRule="evenodd" />
                    </svg>
                    <span><strong>{plan.quota}</strong> 字数额度</span>
                  </div>
                  <div className="flex items-center gap-2">
                    <svg className="w-4 h-4 text-blue-600" fill="currentColor" viewBox="0 0 20 20">
                      <path fillRule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clipRule="evenodd" />
                    </svg>
                    <span><strong>{plan.fileUpload}</strong> 文件上传</span>
                  </div>
                </div>

                {/* Features */}
                <ul className="space-y-2 mb-6">
                  {plan.features.map((feature, idx) => (
                    <li key={idx} className="flex items-center gap-2 text-sm text-gray-600">
                      <svg className="w-4 h-4 text-green-600" fill="currentColor" viewBox="0 0 20 20">
                        <path fillRule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clipRule="evenodd" />
                      </svg>
                      {feature}
                    </li>
                  ))}
                </ul>

                {/* Purchase Button */}
                <button
                  onClick={() => handlePurchase(plan.type)}
                  disabled={loadingPlan === plan.type}
                  className={`w-full py-3 rounded-lg font-medium transition flex items-center justify-center ${
                    plan.recommended
                      ? 'bg-blue-600 hover:bg-blue-700 disabled:bg-blue-400 text-white'
                      : 'bg-gray-100 hover:bg-gray-200 disabled:bg-gray-300 text-gray-700'
                  }`}
                >
                  {loadingPlan === plan.type ? (
                    <>
                      <svg className="animate-spin -ml-1 mr-3 h-5 w-5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                        <circle className="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" strokeWidth="4"></circle>
                        <path className="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                      </svg>
                      处理中...
                    </>
                  ) : (
                    '立即购买'
                  )}
                </button>
              </div>
            </div>
          ))}
        </div>

        {/* Footer Info */}
        <div className="mt-12 text-center text-sm text-gray-600">
          <p>所有套餐均支持退款，购买后7天内可申请全额退款</p>
          <p className="mt-2">如有疑问，请联系：<a href="mailto:sjs@cau.edu.cn" className="text-blue-600 hover:text-blue-700">sjs@cau.edu.cn</a></p>
        </div>
      </div>
    </div>
  );
}
