const retrievalEngine = new retrieval_1.HybridRetrievalEngine({}, { url: apiUrl, key: apiKey });
// 缓存已加载的用户文献，避免重复索引
const loadedUserLiteratures = new Set();
async function loadUserLiterature(userId) {
    if (loadedUserLiteratures.has(userId)) {
        logger_1.logger.info(`[Literature] User ${userId} already loaded, skipping`);
        return true;
    }
    const userDir = getUserDir(userId);
    const litJsonFile = path.join(userDir, 'literature.json');
    if (!fs.existsSync(litJsonFile)) {
        logger_1.logger.info(`[Literature] No literature found for user ${userId}`);
        return false;
    }
    try {
        const content = fs.readFileSync(litJsonFile, 'utf-8');
        const rawPapers = JSON.parse(content);
        // 使用 Set 来去重，确保 ID 唯一
        const seenIds = new Set();
        const papers = [];
        for (let i = 0; i < rawPapers.length; i++) {
            const p = rawPapers[i];
            let id = p.id;
            // 如果 ID 已存在，生成新的唯一 ID
            if (!id || seenIds.has(id)) {
                id = p.doi ? `doi_${p.doi.replace(/[^a-zA-Z0-9]/g, '_')}` : `paper_${Date.now()}_${i}_${Math.random().toString(36).substr(2, 9)}`;
            }
            seenIds.add(id);
            papers.push({
                id: id,
                citationId: p.citationId || i + 1,
                title: p.title || '',
                authors: Array.isArray(p.authors) ? p.authors : (p.author ? [{ name: p.author }] : []),
                author: Array.isArray(p.authors)
                    ? p.authors.map((a) => a.name || a).join(', ')
                    : (p.author || ''),
                year: typeof p.year === 'number' ? p.year : (parseInt(p.year) || 0),
                abstract: p.abstract || '',
                keywords: Array.isArray(p.keywords) ? p.keywords : (p.keywords ? p.keywords.split(/[,;]/).map((k) => k.trim()).filter((k) => k) : []),
                journal: p.journal || '',
                volume: p.volume,
                issue: p.issue,
                pages: p.pages,
                doi: p.doi,
                documentType: p.documentType || 'article',
                categories: p.categories,
                references: p.references,
                source: p.source || 'wos',
                rawData: p.rawData,
                embedding: p.embedding,
                chunks: p.chunks,
            });
        }
        if (papers.length > 0) {
            await retrievalEngine.index(papers);
            loadedUserLiteratures.add(userId);
            logger_1.logger.info(`[Literature] Loaded ${papers.length} papers for user ${userId} (${rawPapers.length} raw, ${papers.length} unique)`);
            return true;
        }
    }
    catch (error) {
        logger_1.logger.error(`[Literature] Failed to load for user ${userId}:`, error);
    }
    return false;
}
function extractTextFromFile(file) {
    const ext = path.extname(file.originalname).toLowerCase();
    let content;
    if (file.buffer) {
        content = file.buffer.toString('utf-8');
    }
    else {
        content = fs.readFileSync(file.path, 'utf-8');
    }
    // 移除 BOM 字符（WoS 导出文件常见）
    if (content.charCodeAt(0) === 0xFEFF) {
        content = content.slice(1);
    }
    // WoS 文件：直接返回原始内容（让后续解析函数处理）
    if (content.includes('Clarivate Analytics Web of Science') ||
        content.includes('Web of Science') ||
        content.match(/^FN\s+Clarivate/m) ||
        (content.match(/^ER\s*$/m) && content.match(/^TI\s+/m))) {
        return content;
    }
    if (ext === '.txt' || ext === '.md') {
        return content;
    }
    if (ext === '.json') {
        return content;
    }
    if (ext === '.ris') {
        return parseRisContent(content);
    }
    if (ext === '.bib') {
        return parseBibContent(content);
    }
    // PDF 文件：直接返回原始内容让 AI 处理
    if (ext === '.pdf') {
        return `[PDF Document: ${file.originalname}]\n\n${content}`;
    }
    return `[File: ${file.originalname}]\n${content.slice(0, 5000)}]`;
}
function parseWosContent(content) {
    const papers = [];
    // 修复 1: 支持多种 ER 结尾格式（ER\n, ER \n, \nER\n）
    const records = content.split(/^ER\s*$/m);
    for (const record of records) {
        // 修复 2: 检查记录是否有效（必须有 TI 字段且不是空记录）
        if (!record.trim() || !record.match(/^TI\s/m))
            continue;
        let title = '', author = '', journal = '', year = '', abstract = '', keywords = '';
        const authors = [];
        const keywordsArr = [];
        const lines = record.split('\n');
        for (let i = 0; i < lines.length; i++) {
            const line = lines[i];
            const trimmed = line.trim();
            // 跳过空行和元数据行（FN, VR 等）
            if (!trimmed || trimmed.startsWith('FN ') || trimmed.startsWith('VR ') || trimmed.startsWith('PT ')) {
                continue;
            }
            // 标题 (TI)
            if (line.startsWith('TI ')) {
                title = line.replace('TI ', '').trim();
                // 处理续行（以 3 个空格开头的续行）
                let j = i + 1;
                while (j < lines.length && lines[j].match(/^   \S/)) {
                    title += ' ' + lines[j].trim();
                    j++;
                }
                i = j - 1;
            }
            // 作者 (AU) - 每行一个作者
            else if (line.startsWith('AU ')) {
                const au = line.replace('AU ', '').trim();
                if (au && !authors.includes(au)) {
                    authors.push(au);
                }
            }
            // 期刊 (SO)
            else if (line.startsWith('SO ')) {
                journal = line.replace('SO ', '').trim();
            }
            // 出版年份 (PY)
            else if (line.startsWith('PY ')) {
                const pyMatch = line.match(/PY\s+(\d{4})/);
                if (pyMatch) {
                    year = pyMatch[1];
                }
            }
            // 出版日期 (PD) - 备用年份来源
            else if (line.startsWith('PD ') && !year) {
                const pdMatch = line.match(/(\d{4})/);
                if (pdMatch) {
                    year = pdMatch[1];
                }
            }
            // 摘要 (AB)
            else if (line.startsWith('AB ')) {
                const abs = [];
                abs.push(line.replace('AB ', '').trim());
                // 处理续行（以 3 个空格开头，直到遇到新字段）
                let j = i + 1;
                while (j < lines.length && lines[j].match(/^   \S/) && !lines[j].match(/^   [A-Z][A-Z] /)) {
                    const cont = lines[j].trim();
                    if (cont && !cont.startsWith('RI ') && !cont.startsWith('OI ') && !cont.startsWith('C1 ')) {
                        abs.push(cont);
                    }
                    j++;
                }
                abstract = abs.join(' ');
                i = j - 1;
            }
            // 关键词 (DE - Author Keywords)
            else if (line.startsWith('DE ')) {
                const kw = line.replace('DE ', '').trim();
                if (kw) {
                    keywordsArr.push(...kw.split(/;/).map(k => k.trim()).filter(k => k));
                }
            }
            // 关键词 (ID - Keywords Plus)
            else if (line.startsWith('ID ')) {
                const kw = line.replace('ID ', '').trim();
                if (kw) {
                    keywordsArr.push(...kw.split(/;/).map(k => k.trim()).filter(k => k));
                }
            }
            // DOI (DI) - 可选信息
            else if (line.startsWith('DI ')) {
                // DOI 可用于验证，但不在输出中显示
            }
            // UT (Unique Identifier) - WoS ID
            else if (line.startsWith('UT ')) {
                // WoS ID 可用于验证
            }
        }
        author = authors.join('; ');
        keywords = keywordsArr.join('; ');
        // 只添加有标题的记录
        if (title) {
            papers.push(`【文献 ${papers.length + 1}】
标题：${title}
作者：${author}
期刊：${journal}
年份：${year}
摘要：${abstract}
关键词：${keywords}`);
        }
    }
    logger_1.logger.info('[WoS Parse] Parsed', papers.length, 'papers');
    return papers.join('\n\n');
}
function parseRisContent(content) {
    const papers = [];
    const entries = content.split('\n\n');
    for (const entry of entries) {
        if (!entry.trim())
            continue;
        let title = '', author = '', journal = '', year = '', abstract = '', keywords = '';
        const lines = entry.split('\n');
        for (const line of lines) {
            const parts = line.match(/^([A-Z][A-Z0-9])  - (.*)$/);
            if (!parts)
                continue;
            const tag = parts[1];
            const value = parts[2];
            switch (tag) {
                case 'TI':
                    title = value;
                    break;
                case 'AU':
                    author += (author ? '; ' : '') + value;
                    break;
                case 'JO':
                case 'JF':
                    journal = value;
                    break;
                case 'PY':
                case 'Y1':
                    year = value.split('/')[0];
                    break;
                case 'AB':
                    abstract = value;
                    break;
                case 'KW':
                    keywords += (keywords ? '; ' : '') + value;
                    break;
            }
        }
        if (title) {
            papers.push(`【文献 ${papers.length + 1}】
标题: ${title}
作者: ${author}
期刊: ${journal}
年份: ${year}
摘要: ${abstract}
关键词: ${keywords}`);
        }
    }
    return papers.join('\n\n');
}
function parseBibContent(content) {
    const papers = [];
    const entries = content.split('@');
    for (let i = 1; i < entries.length; i++) {
        const entry = entries[i];
        if (!entry.trim())
            continue;
        let title = '', author = '', journal = '', year = '', abstract = '';
        const matches = entry.matchAll(/(\w+)\s*=\s*\{([^}]+)\}/g);
        for (const match of matches) {
            const key = match[1].toLowerCase();
            const value = match[2];
            switch (key) {
                case 'title':
                    title = value;
                    break;
                case 'author':
                    author = value.replace(/ and /g, '; ');
                    break;
                case 'journal':
                case 'booktitle':
                    journal = value;
                    break;
                case 'year':
                    year = value;
                    break;
                case 'abstract':
                    abstract = value;
                    break;
            }
        }
        if (title) {
            papers.push(`【文献 ${papers.length + 1}】
标题: ${title}
作者: ${author}
期刊: ${journal}
年份: ${year}
摘要: ${abstract}`);
        }
    }
    return papers.join('\n\n');
}
// 检测文献格式类型
function detectLiteratureFormat(content) {
    // 检查是否为 WoS 格式
    if (content.includes('Clarivate Analytics Web of Science') ||
        content.includes('FN Clarivate') ||
        content.match(/^FN\s+Clarivate/m)) {
        return 'wos';
    }
    // 检查是否为 CNKI 专用格式（有 DS CNKI 标记）
    if (content.includes('DS CNKI') || content.includes('DS cnki')) {
        return 'cnki';
    }
    // 检查是否为 RefWorks 格式（以 % 数字开头或有 TY  - JOUR）
    if (content.match(/^%\s*\d/m) || content.match(/^TY\s+-/m)) {
        return 'refworks';
    }
    // 检查是否有 WoS 格式的字段标记（TI  -, AU  - 等）
    if (content.match(/^TI\s+-/m) && content.match(/^AU\s+-/m)) {
        return 'wos';
    }
    return 'unknown';
}
// 安全分割文献条目，带超时保护
function safeSplitEntries(content, format) {
    const MAX_ENTRIES = 10000; // 防止内存溢出
    const MAX_LENGTH = 10000000; // 10MB 限制
    if (content.length > MAX_LENGTH) {
        logger_1.logger.warn(`[Parse] Content too large (${content.length} chars), truncating to ${MAX_LENGTH}`);
        content = content.substring(0, MAX_LENGTH);
    }
    let entries = [];
    try {
        switch (format) {
            case 'wos':
                // WoS 格式：按 ER 行分割
                entries = content.split(/\nER\s*\n/).filter(e => e.trim().length > 20);
                break;
            case 'cnki':
                // CNKI 格式：按 RT 或空行分割
                if (content.match(/^RT\s/m)) {
                    entries = content.split(/(?=^RT\s)/m).filter(e => e.trim().length > 20);
                }
                else {
                    entries = content.split(/\n\s*\n/).filter(e => e.trim().length > 20);
                }
                break;
            case 'refworks':
                // RefWorks 格式：按 % 数字 或 TY 开头分割
                entries = content.split(/(?=^%\s*\d)|(?=^TY\s+-)/m).filter(e => e.trim().length > 20);
                break;
            default:
                // 未知格式：按双换行分割
                entries = content.split(/\n\s*\n/).filter(e => e.trim().length > 20);
        }
    }
    catch (e) {
        logger_1.logger.error('[Parse] Error splitting entries:', e);
        // 降级处理：简单按行分割
        entries = content.split('\n').filter(e => e.trim().length > 20);
    }
    // 限制条目数量
    if (entries.length > MAX_ENTRIES) {
        logger_1.logger.warn(`[Parse] Too many entries (${entries.length}), limiting to ${MAX_ENTRIES}`);
        entries = entries.slice(0, MAX_ENTRIES);
    }
    return entries;
}
function parseLiteratureToStructured(content) {
    const FIELD_MAP = {
        'wos': {
            title: ['TI  ', 'TI-'],
            author: ['AU  ', 'AU-', 'AF  ', 'AF-'],
            journal: ['SO  ', 'SO-', 'J9  ', 'J9-'],
            year: ['PY  ', 'PY-', 'Y1  ', 'Y1-'],
            abstract: ['AB  ', 'AB-'],
            keywords: ['DE  ', 'DE-', 'ID  ', 'ID-']
        },
        'cnki': {
            title: ['T1 ', 'TI '],
            author: ['A1 ', 'AU ', 'A3 '],
            journal: ['PB ', 'JO ', 'JF ', 'SO '],
            year: ['YR ', 'PY ', 'Y1 '],
            abstract: ['AB '],
            keywords: ['K1 ', 'KW ']
        },
        'refworks': {
            title: ['TI  -', 'T1  -'],
            author: ['AU  -', 'A1  -', 'AF  -'],
            journal: ['SO  -', 'JO  -', 'JF  -'],
            year: ['PY  -', 'Y1  -'],
            abstract: ['AB  -', 'N2  -'],
            keywords: ['KW  -', 'K1  -']
        }
    };
    void FIELD_MAP;
    const papers = [];
    // 检测文件格式并使用安全分割
    const format = detectLiteratureFormat(content);
    logger_1.logger.info(`[Parse] Detected format: ${format}`);
    const entries = safeSplitEntries(content, format);
    logger_1.logger.info(`[Parse] Split into ${entries.length} entries`);
    for (const entry of entries) {
        if (!entry.trim() || entry.length < 20)
            continue;
        const lines = entry.split('\n');
        let title = '', journal = '', year = '', abstract = '', doi = '';
        const authors = [];
        const keywordsArr = [];
        let currentField = null;
        for (const line of lines) {
            const trimmed = line.trim();
            if (!trimmed)
                continue;
            const isContinuation = line.match(/^\s{3,}/) && !trimmed.includes('  -');
            if (trimmed.startsWith('TI ') || trimmed.startsWith('TI-') || trimmed.startsWith('T1 ')) {
                title = trimmed.replace(/^(TI|T1)\s*-?\s*/, '').trim();
                currentField = null;
            }
            else if (trimmed.startsWith('AU ') || trimmed.startsWith('AU-') || trimmed.startsWith('A1 ') || trimmed.startsWith('AF ') || trimmed.startsWith('AF-')) {
                const au = trimmed.replace(/^(AU|A1|AF)\s*-?\s*/, '').trim();
                if (au && !authors.includes(au))
                    authors.push(au);
                currentField = 'author';
            }
            else if (trimmed.startsWith('A3 ')) {
                const aus = trimmed.replace(/^A3\s*/, '').trim();
                if (aus) {
                    authors.push(...aus.split(/[;]/).map(a => a.trim()).filter(a => a));
                }
                currentField = 'author';
            }
            else if (isContinuation && currentField === 'author') {
                const cont = trimmed.replace(/^,\s*/, '').trim();
                if (cont && authors.length > 0) {
                    const lastAuthor = authors[authors.length - 1];
                    authors[authors.length - 1] = lastAuthor + ' ' + cont;
                }
            }
            else if (trimmed.startsWith('SO ') || trimmed.startsWith('SO-') || trimmed.startsWith('PB ') || trimmed.startsWith('JO ') || trimmed.startsWith('JF ')) {
                if (!journal) {
                    journal = trimmed.replace(/^(SO|PB|JO|JF)\s*-?\s*/, '').trim();
                }
                currentField = null;
            }
            else if (trimmed.startsWith('PY ') || trimmed.startsWith('PY-') || trimmed.startsWith('YR ') || trimmed.startsWith('Y1 ')) {
                if (!year) {
                    year = trimmed.replace(/^(PY|YR|Y1)\s*-?\s*/, '').trim().substring(0, 4);
                }
                currentField = null;
            }
            else if (trimmed.startsWith('AB ') || trimmed.startsWith('AB-')) {
                if (!abstract) {
                    abstract = trimmed.replace(/^AB\s*-?\s*/, '').trim();
                }
                currentField = null;
            }
            else if (trimmed.startsWith('DE ') || trimmed.startsWith('DE-') || trimmed.startsWith('ID ') || trimmed.startsWith('ID-') || trimmed.startsWith('KW ') || trimmed.startsWith('K1 ')) {
                const kw = trimmed.replace(/^(DE|ID|KW|K1)\s*-?\s*/, '').trim();
                if (kw) {
                    keywordsArr.push(...kw.split(/[;,,]/).map(k => k.trim()).filter(k => k));
                }
                currentField = null;
            }
            else if (trimmed.startsWith('DI ') || trimmed.startsWith('DI-') || trimmed.startsWith('DO ') || trimmed.startsWith('DO-')) {
                if (!doi) {
                    doi = trimmed.replace(/^(DI|DO)\s*-?\s*/, '').trim();
                }
                currentField = null;
            }
            else {
                currentField = null;
            }
        }
        if (title && !title.startsWith('FN ') && !title.startsWith('VR ') && !title.startsWith('ER')) {
            papers.push({
                citationId: papers.length + 1,
                title,
                author: authors.join(', '),
                journal,
                year,
                abstract,
                keywords: keywordsArr.join(', '),
                doi,
                retrievalText: '',
                chunks: [],
                raw: entry
            });
        }
    }
    logger_1.logger.info('[Parse] Parsed', papers.length, 'papers');
    return hydrateLiteraturePapers(papers);
}
function parseWoSFormat(content) {
    const papers = [];
    const entries = content.split(/\nER\s*\n/);
    for (const entry of entries) {
        if (!entry.trim() || !entry.includes('TI  -'))
            continue;
        const lines = entry.split('\n');
        let title = '', author = '', journal = '', year = '', abstract = '', keywords = '', doi = '';
        let authors = [];
        let keywordsArr = [];
        for (let i = 0; i < lines.length; i++) {
            const line = lines[i].trim();
            if (line.startsWith('TI  -'))
                title = line.replace(/^TI\s*-\s*/, '').trim();
            else if (line.startsWith('AU  -')) {
                const au = line.replace(/^AU\s*-\s*/, '').trim();
                if (au)
                    authors.push(au);
            }
            else if (line.startsWith('AF  -')) {
                const af = line.replace(/^AF\s*-\s*/, '').trim();
                if (af && !authors.includes(af))
                    authors.push(af);
            }
            else if (line.startsWith('SO  -'))
                journal = line.replace(/^SO\s*-\s*/, '').trim();
            else if (line.startsWith('PY  -'))
                year = line.replace(/^PY\s*-\s*/, '').trim().substring(0, 4);
            else if (line.startsWith('AB  -')) {
                abstract = line.replace(/^AB\s*-\s*/, '').trim();
                let j = i + 1;
                while (j < lines.length && lines[j].startsWith('   ')) {
                    abstract += ' ' + lines[j].trim();
                    j++;
                }
            }
            else if (line.startsWith('DE  -') || line.startsWith('ID  -')) {
                const kw = line.replace(/^(DE|ID)\s*-\s*/, '').trim();
                if (kw)
                    keywordsArr.push(kw);
            }
            else if (line.startsWith('DI  -'))
                doi = line.replace(/^DI\s*-\s*/, '').trim();
        }
        author = authors.join(', ');
        keywords = keywordsArr.join(', ');
        if (title)
            papers.push({ citationId: papers.length + 1, title, author, journal, year, abstract, keywords, doi, retrievalText: '', chunks: [], raw: entry });
    }
    return hydrateLiteraturePapers(papers);
}
function parseCNKIFormat(content) { return hydrateLiteraturePapers(parseLiteratureToStructured(content)); }
function parseChineseFormat(content) { return hydrateLiteraturePapers(parseLiteratureToStructured(content)); }
function validateCitations(response, searchResults) {
    const citationRegex = /\(([A-Z][a-z]+(?:\s+et\s+al\.)?),?\s*(\d{4})[a-z]?\)/g;
    const citations = [];
    let match;
    while ((match = citationRegex.exec(response)) !== null) {
        citations.push({
            author: match[1],
            year: match[2],
            full: match[0]
        });
    }
    if (citations.length === 0) {
        return { valid: true, invalidCitations: [], stats: "未检测到引用" };
    }
    const invalidCitations = [];
    const validCitations = [];
    for (const citation of citations) {
        let found = false;
        const authorName = citation.author.toLowerCase().replace(' et al.', '');
        for (const result of searchResults) {
            const paper = result.paper;
            const paperAuthors = paper.author.toLowerCase();
            const paperYear = paper.year;
            if (paperAuthors.includes(authorName) && paperYear === citation.year) {
                found = true;
                break;
            }
        }
        if (found) {
            validCitations.push(citation.full);
        }
        else {
            invalidCitations.push(citation.full);
        }
    }
    return {
        valid: invalidCitations.length === 0,
        invalidCitations,
        stats: `总计 ${citations.length} 个引用，有效 ${validCitations.length} 个，无效 ${invalidCitations.length} 个`
    };
}
function convertCitationsToLaTeX(content, papers) {
    const citationRegex = /\(([A-Z][a-z]+(?:\s+et\s+al\.)?),?\s*(\d{4})[a-z]?\)/g;
    return content.replace(citationRegex, (match, author, year) => {
        const authorName = author.toLowerCase().replace(' et al.', '');
        for (const paper of papers) {
            const paperAuthors = (paper.author || '').toLowerCase();
            const paperYear = String(paper.year || '');
            if (paperAuthors.includes(authorName) && paperYear === year && paper.citationId) {
                return `\\cite{${paper.citationId}}`;
            }
        }
        return match;
    });
}
async function searchLiterature(query, papers, maxResults = 10, apiUrlForEmbedding = currentApiUrl, apiKeyForEmbedding = currentApiKey, embeddingModelName = currentEmbeddingModel) {
    const hydrated = hydrateLiteraturePapers(papers);
    if (!hydrated.length)
        return [];
    const queryWords = query.toLowerCase().split(/\s+/).filter(w => w.length > 1);
    let queryVector = [];
    if (apiKeyForEmbedding) {
        try {
            const vectors = await callEmbeddings(apiUrlForEmbedding, apiKeyForEmbedding, embeddingModelName, query);
            queryVector = vectors[0] || [];
        }
        catch (e) {
            logger_1.logger.error('[Embedding] Query embedding failed, falling back to lexical retrieval:', e);
        }
    }
    else {
        logger_1.logger.warn('[Embedding] No API key configured, falling back to lexical retrieval');
    }
    const results = [];
    for (const paper of hydrated) {
        let lexicalScore = 0;
        const matchFields = [];
        const titleLower = (paper.title || '').toLowerCase();
        const abstractLower = (paper.abstract || '').toLowerCase();
        const keywordsLower = (Array.isArray(paper.keywords) ? paper.keywords.join(', ') : (paper.keywords || '')).toLowerCase();
        const authorLower = (paper.author || '').toLowerCase();
        const journalLower = (paper.journal || '').toLowerCase();
        for (const word of queryWords) {
            if (titleLower.includes(word)) {
                lexicalScore += 10;
                if (!matchFields.includes('title'))
                    matchFields.push('title');
            }
            if (keywordsLower.includes(word)) {
                lexicalScore += 8;
                if (!matchFields.includes('keywords'))
                    matchFields.push('keywords');
            }
            if (abstractLower.includes(word)) {
                lexicalScore += 5;
                if (!matchFields.includes('abstract'))
                    matchFields.push('abstract');
            }
            if (authorLower.includes(word)) {
                lexicalScore += 3;
                if (!matchFields.includes('author'))
                    matchFields.push('author');
            }
            if (journalLower.includes(word)) {
                lexicalScore += 2;
                if (!matchFields.includes('journal'))
                    matchFields.push('journal');
            }
        }
        const yearMatch = query.match(/\d{4}/);
        if (yearMatch && paper.year.includes(yearMatch[0])) {
            lexicalScore += 4;
            if (!matchFields.includes('year'))
                matchFields.push('year');
        }
        const vectorScore = queryVector.length && paper.embedding?.length ? cosineSimilarity(queryVector, paper.embedding) : 0;
        const score = vectorScore * 100 + lexicalScore;
        if (score > 0) {
            results.push({ paper, score, matchFields, vectorScore, lexicalScore });
        }
    }
    results.sort((a, b) => b.score - a.score);
    return results.slice(0, maxResults);
}
async function searchLiteratureAbstract(query, papers, maxResults = 5, apiUrlForEmbedding = currentApiUrl, apiKeyForEmbedding = currentApiKey, embeddingModelName = currentEmbeddingModel) {
    const hydrated = hydrateLiteraturePapers(papers);
    if (!hydrated.length)
        return [];
    const queryWords = query.toLowerCase().split(/\s+/).filter(w => w.length > 2);
    let queryVector = [];
    if (apiKeyForEmbedding) {
        try {
            const vectors = await callEmbeddings(apiUrlForEmbedding, apiKeyForEmbedding, embeddingModelName, query);
            queryVector = vectors[0] || [];
        }
        catch (e) {
            logger_1.logger.error('[Embedding] Query embedding failed:', e);
        }
    }
    const results = [];
    for (const paper of hydrated) {
        let lexicalScore = 0;
        const matchFields = [];
        const abstractLower = (paper.abstract || '').toLowerCase();
        for (const word of queryWords) {
            if (abstractLower.includes(word)) {
                lexicalScore += 10;
                if (!matchFields.includes('abstract'))
                    matchFields.push('abstract');
            }
        }
        const vectorScore = queryVector.length && paper.embedding?.length ? cosineSimilarity(queryVector, paper.embedding) : 0;
        const score = vectorScore * 100 + lexicalScore;
        if (score > 0) {
            results.push({ paper, score, matchFields, vectorScore, lexicalScore });
        }
    }
    results.sort((a, b) => b.score - a.score);
    return results.slice(0, maxResults);
}
async function webSearch(query, numResults = 10, customUrl, customKey) {
    const apiKey = customKey || exaApiKey;
    if (!apiKey) {
        logger_1.logger.warn("[WebSearch] No API key configured");
        return '';
    }
    try {
        const response = await fetch('https://api.tavily.com/search', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
            },
            body: JSON.stringify({
                api_key: apiKey,
                query: query,
                max_results: numResults,
                include_answer: true,
                include_raw_content: false,
            }),
        });
        if (!response.ok) {
            logger_1.logger.error("[WebSearch] Tavily API error:", response.status);
            return '';
        }
        const data = await response.json();
        if (!data.results || data.results.length === 0) {
            return '';
        }
        let context = `=== 网络检索结果 ===\n\n`;
        for (let i = 0; i < Math.min(data.results.length, 10); i++) {
            const r = data.results[i];
            context += `【${i + 1}】${r.title}\n`;
            context += `链接: ${r.url}\n`;
            context += `摘要: ${r.content ? r.content.substring(0, 300) : '无'}\n\n`;
        }
        logger_1.logger.info("[WebSearch] Found", data.results.length, "results for:", query);
        return context;
    }
    catch (e) {
        logger_1.logger.error("[WebSearch] Error:", e);
        return '';
    }
}
