    const embeddingModelName = req.body.embeddingModel || currentEmbeddingConfig.model || embeddingModel;
    const embeddingEnabled = req.body.embeddingEnabled !== 'false' && currentEmbeddingConfig.enabled;
    const embeddingUrl = req.body.embeddingUrl || currentEmbeddingConfig.url || apiUrl;
    const embeddingKey = req.body.embeddingKey || currentEmbeddingConfig.key || apiKey;
