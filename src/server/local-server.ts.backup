    async function restartFeishuWebSocket() {
        if (feishuWebSocketClient) {
            try {
                await feishuWebSocketClient.stop();
                logger_1.logger.info('[Feishu] Stopped old WebSocket client');
            }
            catch (e) {
                logger_1.logger.warn("[Feishu] Error stopping old client:", e);
            }
        }
        try {
            const conversationFlow = new conversation_flow_1.ConversationFlow({
                send: async (userId, message) => {
                    logger_1.logger.info(`[Message] to ${userId}: ${message.slice(0, 100)}...`);
                }
            }, sessionStore, { apiUrl, apiKey, embeddingModel }, retrievalEngine);
            const feishuHandler = new feishu_handler_1.FeishuHandler({
                appId: feishuAppId,
                appSecret: feishuAppSecret,
            }, conversationFlow, processChatMessage);
            feishuWebSocketClient = new feishu_websocket_1.FeishuWebSocketClient({
                appId: feishuAppId,
                appSecret: feishuAppSecret,
            }, feishuHandler);
            await feishuWebSocketClient.start();
            logger_1.logger.info('[Feishu] ✓ WebSocket client started');
        }
        catch (error) {
            logger_1.logger.error('[Feishu] Failed to start WebSocket:', error);
        }
    }
