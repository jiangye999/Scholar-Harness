function isAnthropicModel(model) {
    const m = model.toLowerCase();
    return m.includes('minimax-m2.7') || m.includes('claude') || m.includes('anthropic');
}
async function callLLM(apiUrl, apiKey, model, messages, temperature, maxTokens) {
    const useAnthropic = isAnthropicModel(model);
    if (useAnthropic) {
        const response = await fetch(apiUrl + "/v1/messages", {
            method: "POST",
            headers: {
                "Content-Type": "application/json",
                "x-api-key": apiKey,
                "anthropic-version": "2023-06-01",
            },
            body: JSON.stringify({
                model: model,
                messages: messages.map(m => ({
                    role: m.role === "assistant" ? "assistant" : "user",
                    content: m.content
                })),
                temperature: temperature || 0.7,
                max_tokens: maxTokens || 4096,
            }),
        });
        if (!response.ok) {
            const errText = await response.text();
            throw new Error(`API 错误 (${response.status}): ${errText}`);
        }
        const data = await response.json();
        let content = "";
        let thinking;
        if (data.content) {
            for (const block of data.content) {
                if (block.type === "text" && block.text) {
                    content += block.text;
                }
                else if (block.type === "thinking" && block.thinking) {
                    thinking = block.thinking;
                }
            }
        }
        return { content, thinking };
    }
    else {
        const response = await fetch(apiUrl + "/chat/completions", {
            method: "POST",
            headers: {
                "Content-Type": "application/json",
                Authorization: "Bearer " + apiKey,
            },
            body: JSON.stringify({
                model: model,
                messages: messages,
                temperature: temperature || 0.7,
                max_tokens: maxTokens || 4096,
            }),
        });
        if (!response.ok) {
            const errText = await response.text();
            throw new Error(`API 错误 (${response.status}): ${errText}`);
        }
        const data = await response.json();
        return { content: data.choices?.[0]?.message?.content || "" };
    }
}
// APIClient 实现
function normalizeApiBase(apiUrl) {
    return apiUrl.replace(/\/$/, "");
}
async function callEmbeddings(apiUrl, apiKey, model, input) {
    const normalizedInput = Array.isArray(input) ? input : [input];
    if (normalizedInput.length === 0)
        return [];
    const response = await fetch(normalizeApiBase(apiUrl) + "/embeddings", {
        method: "POST",
        headers: {
            "Content-Type": "application/json",
            Authorization: "Bearer " + apiKey,
        },
        body: JSON.stringify({
            model,
            input: normalizedInput,
            encoding_format: "float",
        }),
    });
    if (!response.ok) {
        const errText = await response.text();
        throw new Error(`Embedding API 错误 (${response.status}): ${errText}`);
    }
    const data = await response.json();
    const vectors = (data.data || [])
        .sort((a, b) => (a.index || 0) - (b.index || 0))
        .map(item => item.embedding || []);
    if (vectors.length !== normalizedInput.length) {
        throw new Error(`Embedding 返回数量异常: expected=${normalizedInput.length}, got=${vectors.length}`);
    }
    return vectors;
}
function cosineSimilarity(vecA, vecB) {
    if (!vecA.length || !vecB.length || vecA.length !== vecB.length)
        return 0;
    let dot = 0;
    let normA = 0;
    let normB = 0;
    for (let i = 0; i < vecA.length; i++) {
        const a = vecA[i] || 0;
        const b = vecB[i] || 0;
        dot += a * b;
        normA += a * a;
        normB += b * b;
    }
    if (normA === 0 || normB === 0)
        return 0;
    return dot / (Math.sqrt(normA) * Math.sqrt(normB));
}
function createPaperRetrievalText(paper) {
    const fields = [
        paper.title,
        paper.keywords,
        paper.abstract,
        paper.journal,
        paper.author,
        paper.year ? `year ${paper.year}` : "",
        paper.doi ? `doi ${paper.doi}` : ""
    ].filter(Boolean);
    return fields.join("\n");
}
function hydrateLiteraturePapers(papers) {
    return papers.map((paper, index) => ({
        ...paper,
        citationId: paper.citationId || index + 1,
        retrievalText: paper.retrievalText || createPaperRetrievalText(paper),
        chunks: paper.chunks || [],
        embedding: Array.isArray(paper.embedding) ? paper.embedding : undefined,
    }));
}
async function ensureLiteratureEmbeddings(papers, apiUrl, apiKey, embeddingModel, disableEmbedding = false) {
    if (disableEmbedding) {
        logger_1.logger.info('[Embedding] Embedding generation is disabled. Using lexical search only.');
        return hydrateLiteraturePapers(papers);
    }
    const hydrated = hydrateLiteraturePapers(papers);
    const missing = hydrated
        .map((paper, index) => ({ paper, index }))
        .filter(item => !item.paper.embedding || item.paper.embedding.length === 0);
    if (missing.length === 0) {
        logger_1.logger.info(`[Embedding] All ${hydrated.length} papers already have embeddings`);
        return hydrated;
    }
    if (!apiKey) {
        logger_1.logger.warn(`[Embedding] Missing API key, skip embedding build for ${missing.length} papers`);
        return hydrated;
    }
    logger_1.logger.info(`[Embedding] Building embeddings for ${missing.length} papers using ${embeddingModel}...`);
    const batchSize = 10;
    let successCount = 0;
    let failCount = 0;
    let apiErrorCount = 0;
    const maxApiErrors = 3;
    for (let start = 0; start < missing.length; start += batchSize) {
        if (apiErrorCount >= maxApiErrors || disableEmbedding) {
            if (disableEmbedding) {
                logger_1.logger.info('[Embedding] Embedding generation has been disabled globally. Using lexical search only.');
            }
            else {
                logger_1.logger.warn(`[Embedding] Stopped after ${maxApiErrors} API errors. Skipping remaining ${missing.length - start} papers.`);
            }
            failCount += missing.length - start;
            break;
        }
        const batch = missing.slice(start, start + batchSize);
        const inputs = batch.map(item => item.paper.retrievalText || createPaperRetrievalText(item.paper));
        try {
            const vectors = await callEmbeddings(apiUrl, apiKey, embeddingModel, inputs);
            batch.forEach((item, idx) => {
                if (vectors[idx] && vectors[idx].length > 0) {
                    hydrated[item.index].embedding = vectors[idx];
                    successCount++;
                }
                else {
                    logger_1.logger.warn(`[Embedding] Empty vector for paper: ${item.paper.title?.substring(0, 50)}`);
                    failCount++;
                }
            });
        }
        catch (e) {
            const errorMsg = e.message;
            logger_1.logger.error(`[Embedding] Failed to build embeddings for batch ${start}-${start + batch.length}:`, errorMsg);
            failCount += batch.length;
            if (errorMsg.includes('404') || errorMsg.includes('403')) {
                apiErrorCount++;
                if (apiErrorCount >= maxApiErrors) {
                    disableEmbedding = true;
                    logger_1.logger.warn('[Embedding] API does not support embeddings. Permanently disabled for this session.');
                }
            }
        }
    }
    logger_1.logger.info(`[Embedding] Completed: ${successCount} success, ${failCount} failed out of ${missing.length} papers`);
    if (successCount === 0 && failCount > 0) {
        logger_1.logger.warn('[Embedding] No embeddings were generated. System will use lexical search (word matching) instead.');
    }
    return hydrated;
}
function createAPIClient(apiUrl, apiKey) {
    return {
        async chat(options) {
            const result = await callLLM(apiUrl, apiKey, options.model, options.messages, options.temperature, options.maxTokens);
            return result.content;
        }
    };
}
function getMemoryFile(userId) {
    const unifiedId = isFeishuUserId(userId) ? getUnifiedUserId(userId) : userId;
    const userMemoryDir = path.join(memoryDir, unifiedId);
    if (!fs.existsSync(userMemoryDir)) {
        fs.mkdirSync(userMemoryDir, { recursive: true });
    }
    const memoryFile = path.join(userMemoryDir, "memory.json");
    logger_1.logger.info(`[getMemoryFile] userId=${userId}, unifiedId=${unifiedId}, file=${memoryFile}, exists=${fs.existsSync(memoryFile)}`);
    return memoryFile;
}
function getConversationFile(userId, conversationId) {
    const unifiedId = isFeishuUserId(userId) ? getUnifiedUserId(userId) : userId;
    const conversationsDir = path.join(memoryDir, unifiedId, "conversations");
    if (!fs.existsSync(conversationsDir)) {
        fs.mkdirSync(conversationsDir, { recursive: true });
    }
    return path.join(conversationsDir, `${conversationId}.json`);
}
function loadUserMemory(userId) {
    const memoryFile = getMemoryFile(userId);
    if (fs.existsSync(memoryFile)) {
        try {
            const data = JSON.parse(fs.readFileSync(memoryFile, 'utf-8'));
            const unifiedId = isFeishuUserId(userId) ? getUnifiedUserId(userId) : userId;
            return {
                userId: unifiedId,
                entries: data.entries || [],
                conversations: data.conversations || [],
                updatedAt: data.updatedAt || new Date().toISOString()
            };
        }
        catch (e) {
            logger_1.logger.warn("[Memory] Failed to load memory:", e);
        }
    }
    const unifiedId = isFeishuUserId(userId) ? getUnifiedUserId(userId) : userId;
    return { userId: unifiedId, entries: [], conversations: [], updatedAt: new Date().toISOString() };
}
function saveUserMemory(memory) {
    const memoryFile = getMemoryFile(memory.userId);
    memory.updatedAt = new Date().toISOString();
    fs.writeFileSync(memoryFile, JSON.stringify(memory, null, 2), 'utf-8');
}
function loadConversation(userId, conversationId) {
    const conversationFile = getConversationFile(userId, conversationId);
    if (fs.existsSync(conversationFile)) {
        try {
            return JSON.parse(fs.readFileSync(conversationFile, 'utf-8'));
        }
        catch (e) {
            logger_1.logger.warn("[Memory] Failed to load conversation:", e);
        }
    }
    return null;
}
function saveConversation(conversation) {
    const unifiedId = isFeishuUserId(conversation.userId) ? getUnifiedUserId(conversation.userId) : conversation.userId;
    const conversationFile = getConversationFile(unifiedId, conversation.id);
    conversation.updatedAt = new Date().toISOString();
    conversation.userId = unifiedId;
    fs.writeFileSync(conversationFile, JSON.stringify(conversation, null, 2), 'utf-8');
}
function getUserDir(userId) {
    const unifiedId = isFeishuUserId(userId) ? getUnifiedUserId(userId) : userId;
    const userDir = path.join(uploadDir, unifiedId);
    if (!fs.existsSync(userDir)) {
        fs.mkdirSync(userDir, { recursive: true });
    }
    return userDir;
}
function searchConversations(userId, query) {
    const memory = loadUserMemory(userId);
    const queryLower = query.toLowerCase();
    return memory.conversations.filter(conv => {
        if (conv.title.toLowerCase().includes(queryLower))
            return true;
        if (conv.summary.toLowerCase().includes(queryLower))
            return true;
        if (conv.keyTopics.some(topic => topic.toLowerCase().includes(queryLower)))
            return true;
        return false;
    });
}
function extractKeyInfo(userMessage, aiResponse, history) {
    const entries = [];
    const combinedText = `用户问题: ${userMessage}\n\nAI回复: ${aiResponse}`;
    const yearMatch = combinedText.match(/(20\d{2})/g);
    if (yearMatch) {
        const years = [...new Set(yearMatch)];
        entries.push({
            key: "years_mentioned",
            value: years.join(", "),
            source: "auto-extracted",
            timestamp: new Date().toISOString()
        });
    }
    const journalMatch = combinedText.match(/期刊[:\s]+([^，。,\n]+)/g);
    if (journalMatch) {
        const journals = [...new Set(journalMatch.map(m => m.replace(/期刊[:\s]+/, '').trim()))];
        entries.push({
            key: "journals_mentioned",
            value: journals.join(", "),
            source: "auto-extracted",
            timestamp: new Date().toISOString()
        });
    }
    const topicMatch = userMessage.match(/(?:关于|研究|探讨|分析)([^，。,\n]+)/);
    if (topicMatch) {
        entries.push({
            key: "research_topic",
            value: topicMatch[1].trim(),
            source: "user-message",
            timestamp: new Date().toISOString()
        });
    }
    return entries;
}
function safeMergeSummary(existing, incoming) {
    if (!existing || existing.trim().length === 0) {
        return incoming;
    }
    if (!incoming || incoming.trim().length === 0) {
        return existing;
    }
    const existingSentences = existing.split(/[。！？.!?]+/).filter(s => s.trim().length > 5);
    const incomingSentences = incoming.split(/[。！？.!?]+/).filter(s => s.trim().length > 5);
    const existingSet = new Set(existingSentences.map(s => s.trim().toLowerCase()));
    const newSentences = [];
    for (const sent of incomingSentences) {
        const normalized = sent.trim().toLowerCase();
        let isDuplicate = false;
        for (const existing of existingSet) {
            if (existing.includes(normalized) || normalized.includes(existing)) {
                isDuplicate = true;
                break;
            }
            const shorterLen = Math.min(existing.length, normalized.length);
            if (shorterLen > 20) {
                const overlap = calculateTextOverlap(existing, normalized);
                if (overlap > 0.7) {
                    isDuplicate = true;
                    break;
                }
            }
        }
        if (!isDuplicate) {
            newSentences.push(sent.trim());
        }
    }
    if (newSentences.length === 0) {
        return existing;
    }
    return existing.trim() + ' ' + newSentences.join('。') + '。';
}
function calculateTextOverlap(text1, text2) {
    const words1 = text1.split(/\s+/);
    const words2 = text2.split(/\s+/);
    const set1 = new Set(words1);
    const set2 = new Set(words2);
    let intersection = 0;
    for (const word of set1) {
        if (set2.has(word))
            intersection++;
    }
    const union = set1.size + set2.size - intersection;
    return union > 0 ? intersection / union : 0;
}
function isLikelyFallback(content, originalMessage) {
    if (!content)
        return true;
    if (content.length < 20)
        return true;
    if (content === originalMessage.substring(0, 2000))
        return true;
    if (content.includes("抱歉") || content.includes("错误") || content.includes("失败"))
        return true;
    return false;
}
